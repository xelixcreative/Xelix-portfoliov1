  .showreel-hint { font-family: var(--mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--white-dim); margin-top: 20px; position: relative; z-index: 1; }
  .showreel-corner { position: absolute; width: 20px; height: 20px; }
  .showreel-corner.tl { top: 12px; left: 12px; border-top: 1px solid var(--violet-bright); border-left: 1px solid var(--violet-bright); }
  .showreel-corner.tr { top: 12px; right: 12px; border-top: 1px solid var(--violet-bright); border-right: 1px solid var(--violet-bright); }
  .showreel-corner.bl { bottom: 12px; left: 12px; border-bottom: 1px solid var(--violet-bright); border-left: 1px solid var(--violet-bright); }
  .showreel-corner.br { bottom: 12px; right: 12px; border-bottom: 1px solid var(--violet-bright); border-right: 1px solid var(--violet-bright); }
  .video-upload-note { margin-top: 16px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.15em; color: rgba(155,127,245,0.5); text-align: center; }
  .video-upload-note span { color: var(--violet-bright); }

  /* SERVICES */
