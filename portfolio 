  .hero-badge .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--violet-bright); }
  .hero-badge .dot.green { background: #22c55e; box-shadow: 0 0 6px #22c55e; animation: dotPulse 2s ease-in-out infinite; }
  .hero-actions { display: flex; gap: 16px; align-items: center; animation: heroIn 1.2s 0.4s cubic-bezier(0.16,1,0.3,1) both; }
  .btn-primary { background: var(--violet); color: var(--white); padding: 16px 36px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; text-decoration: none; transition: all 0.3s; position: relative; overflow: hidden; display: inline-block; }
  .btn-primary::after { content: '↗'; margin-left: 8px; display: inline-block; transition: transform 0.3s; }
  .btn-primary:hover { background: var(--violet-bright); }
  .btn-primary:hover::after { transform: translate(3px,-3px); }
  .btn-ghost { color: var(--white-dim); padding: 16px 36px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; text-decoration: none; border: 1px solid var(--border); transition: all 0.3s; display: inline-block; }
  .btn-ghost:hover { border-color: var(--border-bright); color: var(--white); }
  .hero-right { display: flex; align-items: center; justify-content: center; position: relative; z-index: 2; padding: 120px 48px 80px; }
  .hero-orb-container { position: relative; width: 420px; height: 420px; }
  .hero-orb { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 40% 35%, rgba(155,127,245,0.25) 0%, rgba(123,92,240,0.1) 40%, transparent 70%); animation: orbPulse 6s ease-in-out infinite; }
  @keyframes orbPulse { 0%,100% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.05); opacity: 1; } }
  .hero-orb-ring { position: absolute; inset: -20px; border-radius: 50%; border: 1px solid rgba(123,92,240,0.2); animation: orbRing 8s linear infinite; }
  .hero-orb-ring::before { content: ''; position: absolute; top: -3px; left: 50%; width: 6px; height: 6px; border-radius: 50%; background: var(--violet-bright); box-shadow: 0 0 12px var(--violet-bright); }
  @keyframes orbRing { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  .hero-orb-ring2 { position: absolute; inset: -50px; border-radius: 50%; border: 1px solid rgba(123,92,240,0.08); animation: orbRing 14s linear infinite reverse; }
  .hero-visual-center { position: absolute; inset: 40px; border-radius: 50%; background: var(--charcoal); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; }
  .hero-visual-x { font-family: var(--display); font-size: 120px; line-height: 1; background: linear-gradient(135deg, var(--white) 0%, rgba(123,92,240,0.8) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: orbPulse 4s ease-in-out infinite; }
  .hero-visual-sub { font-family: var(--mono); font-size: 9px; letter-spacing: 0.4em; color: var(--white-dim); text-transform: uppercase; margin-top: 8px; text-align: center; }
  .hero-scroll { position: absolute; bottom: 40px; left: 48px; font-family: var(--mono); font-size: 9px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--white-dim); display: flex; align-items: center; gap: 16px; z-index: 2; }
  .scroll-line { width: 40px; height: 1px; background: var(--border-bright); position: relative; overflow: hidden; }
  .scroll-line::after { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: var(--violet-bright); animation: scrollAnim 2s ease-in-out infinite; }
  @keyframes scrollAnim { to { left: 100%; } }

  /* SHARED */
  section { position: relative; }
  .section-tag { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--violet-bright); display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .section-tag::before { content: '+'; font-size: 14px; }
