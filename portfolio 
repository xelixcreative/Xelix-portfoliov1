<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --black: #050505; --obsidian: #0a0a0a; --charcoal: #111111; --surface: #161616;
    --border: rgba(255,255,255,0.06); --border-bright: rgba(255,255,255,0.12);
    --white: #f5f5f5; --white-dim: rgba(245,245,245,0.5); --white-ghost: rgba(245,245,245,0.08);
