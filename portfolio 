    --violet-ultra: rgba(123,92,240,0.08);
    --mono: 'DM Mono', monospace; --display: 'Bebas Neue', sans-serif; --body: 'Syne', sans-serif;
  }
  html { scroll-behavior: smooth; }
  body { background: var(--black); color: var(--white); font-family: var(--body); overflow-x: hidden; cursor: none; }
  .cursor { position: fixed; top: 0; left: 0; width: 10px; height: 10px; background: var(--violet-bright); border-radius: 50%; pointer-events: none; z-index: 9999; transition: transform 0.1s ease; mix-blend-mode: exclusion; }
  .cursor-ring { position: fixed; top: 0; left: 0; width: 36px; height: 36px; border: 1px solid rgba(155,127,245,0.5); border-radius: 50%; pointer-events: none; z-index: 9998; transition: transform 0.15s ease, width 0.3s, height 0.3s, opacity 0.3s; }
  .cursor-ring.hovering { width: 60px; height: 60px; border-color: var(--violet-bright); opacity: 0.7; }
  body::before { content: ''; position: fixed; inset: 0; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E"); pointer-events: none; z-index: 1000; opacity: 0.4; }
  ::-webkit-scrollbar { width: 3px; }
  ::-webkit-scrollbar-track { background: var(--black); }
  ::-webkit-scrollbar-thumb { background: var(--violet); border-radius: 2px; }

  /* NAV */
  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 24px 48px; display: flex; align-items: center; justify-content: space-between; background: linear-gradient(to bottom, rgba(5,5,5,0.95), transparent); backdrop-filter: blur(2px); transition: background 0.3s, backdrop-filter 0.3s; }
  .nav-logo { font-family: var(--display); font-size: 22px; letter-spacing: 0.15em; color: var(--white); text-decoration: none; }
  .nav-logo span { color: var(--violet-bright); }
  .nav-links { display: flex; gap: 40px; list-style: none; }
  .nav-links a { font-family: var(--mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--white-dim); text-decoration: none; transition: color 0.3s; }
  .nav-links a:hover { color: var(--white); }
  .nav-cta { font-family: var(--mono); font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--white); text-decoration: none; border: 1px solid var(--border-bright); padding: 10px 22px; transition: all 0.3s; position: relative; overflow: hidden; }
  .nav-cta::before { content: ''; position: absolute; inset: 0; background: var(--violet); transform: translateX(-100%); transition: transform 0.3s; }
  .nav-cta:hover::before { transform: translateX(0); }
  .nav-cta span { position: relative; z-index: 1; }

  /* HERO */
  .hero { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; position: relative; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; background: radial-gradient(ellipse 60% 60% at 70% 50%, rgba(123,92,240,0.12) 0%, transparent 70%), radial-gradient(ellipse 30% 40% at 20% 80%, rgba(123,92,240,0.06) 0%, transparent 60%); }
  .hero-grid-lines { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px); background-size: 80px 80px; }
  .hero-left { display: flex; flex-direction: column; justify-content: center; padding: 160px 48px 80px; position: relative; z-index: 2; }
  .hero-tag { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--violet-bright); margin-bottom: 32px; display: flex; align-items: center; gap: 12px; }
  .hero-tag::before { content: ''; width: 32px; height: 1px; background: var(--violet-bright); }
  .hero-title { font-family: var(--display); font-size: clamp(90px, 12vw, 160px); line-height: 0.88; letter-spacing: -0.01em; margin-bottom: 48px; animation: heroIn 1.2s cubic-bezier(0.16,1,0.3,1) both; }
  .hero-title .line1 { display: block; color: var(--white); }
  .hero-title .line2 { display: block; -webkit-text-stroke: 1px rgba(255,255,255,0.25); color: transparent; }
  @keyframes heroIn { from { opacity: 0; transform: translateY(60px); } to { opacity: 1; transform: translateY(0); } }
  .hero-desc { font-size: 14px; font-weight: 400; line-height: 1.8; color: var(--white-dim); max-width: 380px; margin-bottom: 32px; animation: heroIn 1.2s 0.2s cubic-bezier(0.16,1,0.3,1) both; }
  .hero-badges { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 44px; animation: heroIn 1.2s 0.3s cubic-bezier(0.16,1,0.3,1) both; }
